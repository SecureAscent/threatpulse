###############################################################################
# ThreatPulse Intel — PRODUCTION environment
#
#   cp .env.prod.example .env.prod   (or: make setup)
#   then fill in every CHANGEME / value below.
#
# NEVER commit .env.prod — it is git-ignored.
###############################################################################

# ── Database ──────────────────────────────────────────────────────────────
# Postgres runs internally (not published to the host). The password here MUST
# match the one embedded in DATABASE_URL below.
POSTGRES_USER=threatpulse
POSTGRES_PASSWORD=CHANGEME-strong-db-password
POSTGRES_DB=threatpulse

# Connection string used by both the app and the collector.
# Host is the compose service name "postgres".
DATABASE_URL=postgresql://threatpulse:CHANGEME-strong-db-password@postgres:5432/threatpulse

# ── NextAuth ─────────────────────────────────────────────────────────────
# Public URL users hit (must be https and match your domain/cert).
NEXTAUTH_URL=https://yourdomain.com
# Generate with:  openssl rand -base64 32
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# ── TLS / Let's Encrypt (used by scripts/init-letsencrypt.sh + nginx) ──────
# The bare domain (no scheme). Must resolve to this server's public IP.
DOMAIN=yourdomain.com
# Email for Let's Encrypt expiry notices.
CERTBOT_EMAIL=admin@yourdomain.com

# ── Collector ────────────────────────────────────────────────────────────
# How often the intelligence collector runs (minutes).
COLLECTOR_INTERVAL_MINUTES=15
# Organization (by slug) that collected threats are attached to.
# Matches the seeded demo org by default.
COLLECTOR_ORG_SLUG=threatpulse-demo
# Optional NVD API key for higher rate limits (https://nvd.nist.gov/developers/request-an-api-key)
NVD_API_KEY=

# ── App ──────────────────────────────────────────────────────────────────
NODE_ENV=production
# Public app name baked into the client bundle at build time.
NEXT_PUBLIC_APP_NAME=ThreatPulse Intel
