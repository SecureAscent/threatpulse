###############################################################################
# ThreatPulse Intel — PRODUCTION environment
#
#   cp .env.prod.example .env.prod   (or: make setup)
#   then fill in every CHANGEME / value below.
#
# NEVER commit .env.prod — it is git-ignored.
###############################################################################

# ── Database ──────────────────────────────────────────────────────────────
# Postgres runs internally (not published to the host). The password here MUST
# match the one embedded in DATABASE_URL below.
#
# ⚠️ IMPORTANT: use a URL-SAFE password — LETTERS and NUMBERS only.
#    The app connects via a postgresql:// URL, so characters like
#    @ : / # ? $ & ! ^ % break URL parsing and cause:
#        P1000: Authentication failed against database server
#    Generate a safe 32-char alphanumeric password with:
#        openssl rand -base64 48 | tr -dc 'A-Za-z0-9' | head -c 32; echo
POSTGRES_USER=threatpulse
POSTGRES_PASSWORD=CHANGEME_alphanumeric_only_no_symbols
POSTGRES_DB=threatpulse

# Connection string used by both the app and the collector.
# Host is the compose service name "postgres".
# The password here MUST be identical to POSTGRES_PASSWORD above.
DATABASE_URL=postgresql://threatpulse:CHANGEME_alphanumeric_only_no_symbols@postgres:5432/threatpulse

# ── NextAuth ─────────────────────────────────────────────────────────────
# Public URL users hit (must be https and match your domain/cert).
NEXTAUTH_URL=https://yourdomain.com
# Generate with:  openssl rand -base64 32
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# ── TLS / Let's Encrypt (used by scripts/init-letsencrypt.sh + nginx) ──────
# The bare domain (no scheme). Must resolve to this server's public IP.
DOMAIN=yourdomain.com
# Email for Let's Encrypt expiry notices.
CERTBOT_EMAIL=admin@yourdomain.com

# ── DuckDNS DNS-01 challenge (for home servers / blocked port 80) ───────────
# If your ISP/router blocks inbound port 80, the normal HTTP challenge
# (`make ssl`) will time out. Use the DNS challenge instead:
#     make ssl-duckdns
# It proves ownership via a DuckDNS TXT record — no open ports required.
#
# Your DuckDNS token (from the top of https://www.duckdns.org after signing in).
DUCKDNS_TOKEN=
# Just the subdomain part, WITHOUT ".duckdns.org".
# e.g. if your domain is chaugen.duckdns.org, set this to: chaugen
DUCKDNS_SUBDOMAIN=

# ── Collector ────────────────────────────────────────────────────────────
# How often the intelligence collector runs (minutes).
COLLECTOR_INTERVAL_MINUTES=15
# Organization (by slug) that collected threats are attached to.
# Matches the seeded demo org by default.
COLLECTOR_ORG_SLUG=threatpulse-demo
# Optional NVD API key for higher rate limits (https://nvd.nist.gov/developers/request-an-api-key)
NVD_API_KEY=
# Collector control server (powers the "Run Now" buttons on Admin → Collector Health).
# The app reaches the collector at http://collector:${COLLECTOR_CONTROL_PORT} on the
# internal docker network — no host port is published.
COLLECTOR_CONTROL_PORT=9464
# Optional shared secret; if set, it is required as the x-collector-token header.
COLLECTOR_CONTROL_TOKEN=

# ── App ──────────────────────────────────────────────────────────────────
NODE_ENV=production
# Public app name baked into the client bundle at build time.
NEXT_PUBLIC_APP_NAME=ThreatPulse Intel

# ── Smart Notifications (optional — if not set, notifications are logged but not sent) ──
# SMTP email configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-or-token
SMTP_FROM="ThreatPulse Alerts <alerts@threatpulse.com>"

# Slack and Teams webhooks are configured per-user in Settings > Notifications
# Users can test their notification channels from the settings page
