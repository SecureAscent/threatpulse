{
  "name": "ApiKey",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Key Name",
      "description": "Friendly label for this API key"
    },
    "key_prefix": {
      "type": "string",
      "title": "Key Prefix",
      "description": "First 12 characters of the API key for identification"
    },
    "key_hash": {
      "type": "string",
      "title": "Key Hash",
      "description": "SHA-256 hash of the full API key \u2014 never store the plaintext key"
    },
    "scopes": {
      "type": "string",
      "title": "Scopes",
      "description": "Comma-separated: read:threats, write:threats, read:exposures, read:portfolio, read:actors"
    },
    "organization_id": {
      "type": "string",
      "title": "Organization ID"
    },
    "last_used_date": {
      "type": "string",
      "format": "date-time",
      "title": "Last Used"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "title": "Expires At"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "title": "Active"
    }
  },
  "required": [
    "name",
    "key_prefix",
    "key_hash"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}