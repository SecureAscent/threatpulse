{
  "name": "Organization",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Organization Name"
    },
    "plan": {
      "type": "string",
      "enum": [
        "free",
        "smb",
        "enterprise",
        "self_hosted"
      ],
      "default": "free",
      "title": "Plan"
    },
    "seats": {
      "type": "number",
      "default": 5,
      "title": "Seats"
    },
    "data_region": {
      "type": "string",
      "enum": [
        "us-east",
        "us-west",
        "eu-west",
        "ap-southeast"
      ],
      "default": "us-east",
      "title": "Data Region"
    },
    "members": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Members",
      "description": "User IDs of organization members"
    },
    "sso_enabled": {
      "type": "boolean",
      "default": false,
      "title": "SSO Enabled"
    },
    "sso_entry_point": {
      "type": "string",
      "title": "SSO Entry Point",
      "description": "SAML SSO entry point URL (Enterprise tier)"
    },
    "sso_issuer": {
      "type": "string",
      "title": "SSO Issuer / Entity ID"
    },
    "branding_color": {
      "type": "string",
      "title": "Brand Color",
      "description": "Hex color for white-label branding"
    },
    "branding_logo_url": {
      "type": "string",
      "format": "uri",
      "title": "Logo URL"
    },
    "retention_days": {
      "type": "number",
      "default": 90,
      "title": "Retention (days)",
      "description": "Data retention window for this organization"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "name",
    "plan"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.members": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "superadmin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}