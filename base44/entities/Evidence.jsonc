{
  "name": "Evidence",
  "type": "object",
  "properties": {
    "threat_id": {
      "type": "string",
      "title": "Threat ID"
    },
    "file_name": {
      "type": "string",
      "title": "File Name"
    },
    "file_url": {
      "type": "string",
      "format": "uri",
      "title": "File URL (legacy public)",
      "description": "Legacy public URL from the old uploader \u2014 kept for backward compatibility only"
    },
    "file_uri": {
      "type": "string",
      "title": "File URI (Private Storage)",
      "description": "Private storage URI \u2014 use CreateFileSignedUrl to generate a time-limited download link after audited reveal"
    },
    "content_type": {
      "type": "string",
      "title": "Content Type"
    },
    "uploaded_by": {
      "type": "string",
      "title": "Uploaded By"
    },
    "revealed": {
      "type": "boolean",
      "default": false,
      "title": "Revealed",
      "description": "True only after an explicit, audited reveal action \u2014 content stays masked until then"
    },
    "reveal_expires": {
      "type": "string",
      "format": "date-time",
      "title": "Reveal Expires",
      "description": "When the 24-hour reveal window expires and content re-masks"
    },
    "reveal_audit": {
      "type": "string",
      "title": "Reveal Audit Log",
      "description": "Appends 'user @ timestamp' on each reveal action for compliance traceability"
    },
    "content_hash": {
      "type": "string",
      "title": "Content Hash (SHA-256)",
      "description": "Optional integrity fingerprint of the evidence file"
    }
  },
  "required": [
    "threat_id",
    "file_name"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "superadmin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "superadmin"
          }
        }
      ]
    }
  }
}