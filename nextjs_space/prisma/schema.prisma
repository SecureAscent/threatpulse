generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model ParentOrganization {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  archivedAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  organizations Organization[]

  @@index([archivedAt])
}

model Organization {
  id                   String              @id @default(cuid())
  parentOrganizationId String?
  name                 String
  slug                 String              @unique
  description          String?
  timezone             String              @default("UTC")
  archivedAt           DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  parentOrganization   ParentOrganization? @relation(fields: [parentOrganizationId], references: [id])
  departments          Department[]
  users                User[]
  threats              Threat[]
  integrationConfigs   IntegrationConfig[]
  auditEvents          AuditEvent[]
  assets               Asset[]
  productVersions      ProductVersion[]
  sbomDocuments        SbomDocument[]
  softwareComponents   SoftwareComponent[]
  assetVulnerabilities AssetVulnerability[]
  syncRuns             ExternalSyncRun[]
  identityMappings     ExternalIdentityMapping[]

  @@index([parentOrganizationId])
  @@index([archivedAt])
}

model Department {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  slug           String
  archivedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users          User[]
  threats        Threat[]
  assets         Asset[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([archivedAt])
}

model User {
  id             String        @id @default(cuid())
  name           String?
  email          String        @unique
  emailVerified  DateTime?
  image          String?
  password       String
  role           String        @default("ANALYST")
  organizationId String?
  departmentId   String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  department     Department?   @relation(fields: [departmentId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  accounts       Account[]
  sessions       Session[]
  ownedAssets    Asset[]       @relation("AssetOwnerUser")
  identityMappings ExternalIdentityMapping[]

  @@index([organizationId])
  @@index([departmentId])
}

model Threat {
  id             String        @id @default(cuid())
  threatId       String
  title          String
  type           String
  severity       String
  status         String        @default("NEW")
  description    String?
  affectedAssets String?
  source         String?
  indicators     String?
  mitreTactic    String?
  mitreTechnique String?
  cvssScore      Float?
  dateAdded      DateTime      @default(now())
  lastUpdated    DateTime      @updatedAt
  organizationId String
  departmentId   String?
  organization   Organization  @relation(fields: [organizationId], references: [id])
  department     Department?   @relation(fields: [departmentId], references: [id])

  @@unique([organizationId, threatId])
  @@index([organizationId, type])
  @@index([organizationId, severity])
  @@index([organizationId, status])
  @@index([dateAdded])
}

model IntegrationConfig {
  id             String       @id @default(cuid())
  organizationId String
  integrationId  String
  configData     String       @default("{}")
  enabled        Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
  syncRuns       ExternalSyncRun[]

  @@unique([organizationId, integrationId])
  @@index([organizationId])
}

model Asset {
  id                 String       @id @default(cuid())
  organizationId     String
  departmentId       String?
  ownerUserId         String?
  externalSource     String
  externalId         String
  assetType           String
  name                String
  description         String?
  vendor              String?
  productFamily       String?
  model                String?
  currentVersion       String?
  ownerName            String?
  ownerEmail           String?
  businessUnit         String?
  criticality          String?
  lifecycleStatus      String?
  sourceStatus         String?
  sourceUpdatedAt      DateTime?
  sourceDeletedAt      DateTime?
  lastSeenAt           DateTime?
  lastSyncedAt         DateTime?
  rawMetadata          Json?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department           Department?  @relation(fields: [departmentId], references: [id])
  ownerUser            User?        @relation("AssetOwnerUser", fields: [ownerUserId], references: [id])
  productVersions      ProductVersion[]
  vulnerabilities      AssetVulnerability[]

  @@unique([organizationId, externalSource, externalId])
  @@index([organizationId, assetType])
  @@index([organizationId, businessUnit])
  @@index([organizationId, criticality])
  @@index([organizationId, lifecycleStatus])
  @@index([departmentId])
  @@index([ownerUserId])
}

model ProductVersion {
  id                 String       @id @default(cuid())
  organizationId     String
  assetId             String
  externalSource      String
  externalId          String
  version             String
  releaseName         String?
  lifecycleStatus     String?
  releaseDate         DateTime?
  endOfSupportDate    DateTime?
  sourceUpdatedAt     DateTime?
  lastSeenAt          DateTime?
  rawMetadata          Json?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  asset               Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  sbomDocuments       SbomDocument[]
  vulnerabilities    AssetVulnerability[]

  @@unique([organizationId, externalSource, externalId])
  @@index([organizationId, assetId])
  @@index([organizationId, lifecycleStatus])
}

model SbomDocument {
  id                 String       @id @default(cuid())
  organizationId     String
  productVersionId   String
  externalSource     String
  externalId         String
  format              String
  specVersion         String?
  serialNumber        String?
  documentVersion     Int?
  generatedAt         DateTime?
  sourceUpdatedAt     DateTime?
  lastSeenAt          DateTime?
  checksum            String?
  rawDocument         Json?
  rawMetadata         Json?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productVersion      ProductVersion @relation(fields: [productVersionId], references: [id], onDelete: Cascade)
  components          SbomComponent[]

  @@unique([organizationId, externalSource, externalId])
  @@index([organizationId, productVersionId])
  @@index([organizationId, generatedAt])
}

model SoftwareComponent {
  id                 String       @id @default(cuid())
  organizationId     String
  externalSource     String
  externalId         String
  name                String
  version             String?
  supplier            String?
  componentType       String?
  purl                 String?
  cpe                  String?
  swid                 String?
  licenseExpression    String?
  sourceUpdatedAt      DateTime?
  lastSeenAt           DateTime?
  rawMetadata          Json?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sbomMemberships     SbomComponent[]
  vulnerabilities    AssetVulnerability[]

  @@unique([organizationId, externalSource, externalId])
  @@index([organizationId, name, version])
  @@index([organizationId, purl])
  @@index([organizationId, cpe])
}

model SbomComponent {
  id                 String            @id @default(cuid())
  sbomDocumentId     String
  componentId        String
  relationshipType   String?
  scope               String?
  directDependency    Boolean?
  rawMetadata          Json?
  createdAt            DateTime          @default(now())
  sbomDocument        SbomDocument      @relation(fields: [sbomDocumentId], references: [id], onDelete: Cascade)
  component           SoftwareComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@unique([sbomDocumentId, componentId])
  @@index([componentId])
}

model AssetVulnerability {
  id                 String            @id @default(cuid())
  organizationId     String
  assetId             String
  productVersionId   String?
  componentId        String?
  externalSource     String
  externalId         String
  vulnerabilityId    String
  status              String?
  vexStatus           String?
  severity            String?
  cvssScore           Float?
  epssScore           Float?
  kev                  Boolean?
  exploitable          Boolean?
  firstSeenAt          DateTime?
  lastSeenAt           DateTime?
  sourceUpdatedAt      DateTime?
  remediation         String?
  rawMetadata          Json?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  organization        Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  asset               Asset             @relation(fields: [assetId], references: [id], onDelete: Cascade)
  productVersion      ProductVersion?   @relation(fields: [productVersionId], references: [id], onDelete: Cascade)
  component           SoftwareComponent? @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@unique([organizationId, externalSource, externalId])
  @@index([organizationId, vulnerabilityId])
  @@index([organizationId, severity])
  @@index([organizationId, kev])
  @@index([assetId])
  @@index([productVersionId])
  @@index([componentId])
}

model ExternalSyncRun {
  id                   String             @id @default(cuid())
  organizationId       String
  integrationConfigId  String
  provider              String
  syncType              String
  status                String             @default("PENDING")
  cursorBefore          String?
  cursorAfter           String?
  startedAt             DateTime           @default(now())
  completedAt           DateTime?
  recordsRead           Int                @default(0)
  recordsCreated        Int                @default(0)
  recordsUpdated        Int                @default(0)
  recordsDeleted        Int                @default(0)
  recordsFailed         Int                @default(0)
  errorMessage          String?
  metadata              Json?
  organization          Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integrationConfig     IntegrationConfig  @relation(fields: [integrationConfigId], references: [id], onDelete: Cascade)

  @@index([organizationId, provider, startedAt])
  @@index([integrationConfigId, startedAt])
  @@index([status, startedAt])
}

model ExternalIdentityMapping {
  id                   String       @id @default(cuid())
  organizationId       String
  userId               String?
  externalSource       String
  externalIdentity     String
  externalDisplayName  String?
  mappingMethod        String?
  metadata             Json?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                 User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([organizationId, externalSource, externalIdentity])
  @@index([organizationId, userId])
}

model AuditEvent {
  id             String       @id @default(cuid())
  organizationId String
  actorUserId    String
  actorRole      String
  action         String
  entityType     String
  entityId       String?
  departmentId   String?
  metadata       Json?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([organizationId, action])
  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
