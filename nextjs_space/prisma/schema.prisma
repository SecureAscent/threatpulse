generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users              User[]
  threats            Threat[]
  integrationConfigs IntegrationConfig[]
  jiraTickets        JiraTicket[]
  cybellumAssets     CybellumAsset[]
}

model User {
  id             String       @id @default(cuid())
  name           String?
  email          String       @unique
  emailVerified  DateTime?
  image          String?
  password       String
  role           String       @default("ANALYST")
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  accounts       Account[]
  sessions       Session[]
}

model Threat {
  id             String       @id @default(cuid())
  threatId       String       @unique
  title          String
  type           String
  severity       String
  status         String       @default("NEW")
  description    String?
  affectedAssets String?
  source         String?
  indicators     String?
  mitreTactic    String?
  mitreTechnique String?
  cvssScore      Float?
  dateAdded      DateTime     @default(now())
  lastUpdated    DateTime     @updatedAt
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  jiraTickets    JiraTicket[]
  assetLinks     ThreatAssetLink[]

  @@index([organizationId, type])
  @@index([organizationId, severity])
  @@index([organizationId, status])
  @@index([dateAdded])
}

model IntegrationConfig {
  id             String       @id @default(cuid())
  organizationId String
  integrationId  String
  configData     String       @default("{}")
  enabled        Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, integrationId])
  @@index([organizationId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model JiraTicket {
  id             String   @id @default(cuid())
  threatId       String
  threat         Threat   @relation(fields: [threatId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  jiraKey        String?  // e.g. "SEC-123" - null until actually created in Jira
  title          String
  description    String
  priority       String   // Critical, High, Medium, Low
  status         String   @default("DRAFT") // DRAFT, CREATED, IN_PROGRESS, RESOLVED, CLOSED
  affectedPackage String?
  affectedProduct String?
  productOwner   String?
  cvssScore      Float?
  cveId          String?
  remediationSteps String?
  notes          String?
  createdBy      String   // user email
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@index([organizationId])
  @@index([threatId])
}

model CybellumAsset {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  cybellumId     String?  // ID in Cybellum system (null = manually entered)
  productName    String
  productVersion String?
  packageName    String?
  packageVersion String?
  productOwner   String?
  ownerEmail     String?
  department     String?
  riskScore      Float?
  lastSyncedAt   DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  threatLinks    ThreatAssetLink[]
  @@index([organizationId])
}

model ThreatAssetLink {
  id             String        @id @default(cuid())
  threatId       String
  threat         Threat        @relation(fields: [threatId], references: [id], onDelete: Cascade)
  assetId        String
  asset          CybellumAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  linkedBy       String        // user email
  notes          String?
  createdAt      DateTime      @default(now())
  @@unique([threatId, assetId])
  @@index([threatId])
  @@index([assetId])
}
