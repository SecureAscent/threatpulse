generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model ParentOrganization {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  organizations Organization[]
}

model Organization {
  id                   String              @id @default(cuid())
  parentOrganizationId String?
  name                 String
  slug                 String              @unique
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  parentOrganization   ParentOrganization? @relation(fields: [parentOrganizationId], references: [id])
  departments          Department[]
  users                User[]
  threats              Threat[]
  integrationConfigs   IntegrationConfig[]

  @@index([parentOrganizationId])
}

model Department {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  slug           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users          User[]
  threats        Threat[]

  @@unique([organizationId, slug])
  @@index([organizationId])
}

model User {
  id             String        @id @default(cuid())
  name           String?
  email          String        @unique
  emailVerified  DateTime?
  image          String?
  password       String
  role           String        @default("ANALYST")
  organizationId String?
  departmentId   String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  department     Department?   @relation(fields: [departmentId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  accounts       Account[]
  sessions       Session[]

  @@index([organizationId])
  @@index([departmentId])
}

model Threat {
  id             String        @id @default(cuid())
  threatId       String
  title          String
  type           String
  severity       String
  status         String        @default("NEW")
  description    String?
  affectedAssets String?
  source         String?
  indicators     String?
  mitreTactic    String?
  mitreTechnique String?
  cvssScore      Float?
  dateAdded      DateTime      @default(now())
  lastUpdated    DateTime      @updatedAt
  organizationId String
  departmentId   String?
  organization   Organization  @relation(fields: [organizationId], references: [id])
  department     Department?   @relation(fields: [departmentId], references: [id])

  @@unique([organizationId, threatId])
  @@index([organizationId, type])
  @@index([organizationId, severity])
  @@index([organizationId, status])
  @@index([departmentId])
  @@index([dateAdded])
}

model IntegrationConfig {
  id             String       @id @default(cuid())
  organizationId String
  integrationId  String
  configData     String       @default("{}")
  enabled        Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, integrationId])
  @@index([organizationId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
