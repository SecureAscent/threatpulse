{"name":"ActivationKey","type":"object","properties":{"code":{"type":"string","title":"Activation Code","description":"Unique redeemable code, e.g. TP-ABCDE-FGHIJ-KLMNO"},"tier":{"type":"string","enum":["SmallMidsize","Enterprise"],"title":"Tier"},"status":{"type":"string","enum":["active","redeemed"],"default":"active","title":"Status"},"redeemed_by_id":{"type":"string","title":"Redeemed By (user id)"},"redeemed_by_email":{"type":"string","title":"Redeemed By (email)"},"redeemed_date":{"type":"string","format":"date-time","title":"Redeemed Date"},"notes":{"type":"string","title":"Notes"}},"required":["code","tier","status"],"rls":{"read":{"$or":[{"user_condition":{"role":"admin"}},{"user_condition":{"role":"superadmin"}}]},"create":{"$or":[{"user_condition":{"role":"admin"}},{"user_condition":{"role":"superadmin"}}]},"update":{"$or":[{"user_condition":{"role":"admin"}},{"user_condition":{"role":"superadmin"}}]},"delete":{"$or":[{"user_condition":{"role":"admin"}},{"user_condition":{"role":"superadmin"}}]}}}