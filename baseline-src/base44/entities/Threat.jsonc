{"name":"Threat","type":"object","properties":{"title":{"type":"string","title":"Title","description":"Threat headline"},"description":{"type":"string","title":"Description"},"severity":{"type":"string","enum":["Critical","High","Medium","Low"],"default":"Medium","title":"Severity"},"type":{"type":"string","enum":["Vulnerability","Ransomware","Campaign","Malware","Breach","Advisory","Other"],"default":"Other","title":"Threat Type"},"cve_id":{"type":"string","title":"CVE ID"},"cvss_score":{"type":"number","title":"CVSS Score"},"source":{"type":"string","title":"Source","description":"e.g. CISA KEV, NVD, H-ISAC, Dark Reading"},"source_url":{"type":"string","format":"uri","title":"Source URL"},"status":{"type":"string","enum":["New","Analyzing","Mitigated"],"default":"New","title":"Status"},"assigned_to":{"type":"string","title":"Assigned To"},"notes":{"type":"string","title":"Analyst Notes"},"affected_products":{"type":"string","title":"Affected Products"},"estimated_downtime_hours":{"type":"number","title":"Estimated Downtime (hours)","description":"Estimated potential system downtime based on severity and affected product portfolio breadth"},"estimated_recovery_cost":{"type":"number","title":"Estimated Recovery Cost (USD)","description":"Estimated recovery cost based on severity and affected product portfolio breadth"},"first_response_date":{"type":"string","format":"date-time","title":"First Response Date"},"closed_date":{"type":"string","format":"date-time","title":"Closed Date"},"sla_alert_sent":{"type":"boolean","title":"SLA Breach Alert Sent","default":false,"description":"True once an SLA breach alert has been emailed for this threat"}},"required":["title","severity","type","status"],"rls":{"read":{},"create":{"$or":[{"user_condition":{"role":"admin"}},{"user_condition":{"role":"superadmin"}}]},"update":{},"delete":{"$or":[{"user_condition":{"role":"admin"}},{"user_condition":{"role":"superadmin"}}]}}}