{"name":"ThreatActor","type":"object","properties":{"name":{"type":"string","title":"Name","description":"Threat actor / malware family / campaign name"},"aliases":{"type":"string","title":"Aliases"},"kind":{"type":"string","enum":["threat_actor","malware","campaign","darkweb_mention","indicator"],"default":"indicator","title":"Kind"},"ioc_value":{"type":"string","title":"IOC Value","description":"Indicator of compromise (IP, domain, URL, hash, email, etc.)"},"ioc_type":{"type":"string","title":"IOC Type"},"threat_type":{"type":"string","title":"Threat Type","description":"e.g. botnet_cc, payload_delivery, payload"},"confidence":{"type":"string","enum":["low","medium","high"],"default":"medium","title":"Confidence"},"malware_printable":{"type":"string","title":"Malware (display)"},"first_seen":{"type":"string","format":"date-time","title":"First Seen"},"last_seen":{"type":"string","format":"date-time","title":"Last Seen"},"source":{"type":"string","title":"Source","description":"e.g. ThreatFox (abuse.ch), Flare, Flashpoint"},"source_url":{"type":"string","format":"uri","title":"Source URL"},"tags":{"type":"string","title":"Tags"},"reporter":{"type":"string","title":"Reporter"},"notes":{"type":"string","title":"Notes"}},"required":["name","kind","source"],"rls":{"read":{},"create":{"$or":[{"user_condition":{"role":"admin"}},{"user_condition":{"role":"superadmin"}}]},"update":{"$or":[{"user_condition":{"role":"admin"}},{"user_condition":{"role":"superadmin"}}]},"delete":{"$or":[{"user_condition":{"role":"admin"}},{"user_condition":{"role":"superadmin"}}]}}}