{"name":"ExposureFinding","type":"object","properties":{"organizationId":{"type":"string","title":"Organization ID","description":"Tenant scope — required for cross-org validation"},"watchlist_id":{"type":"string","title":"Watchlist ID"},"kind":{"type":"string","enum":["credential_leak","mention","domain_exposure","identity_exposure"],"default":"credential_leak","title":"Kind"},"severity":{"type":"string","enum":["Critical","High","Medium","Low"],"default":"Medium","title":"Severity"},"title":{"type":"string","title":"Title"},"summary":{"type":"string","title":"Summary"},"affected_identity":{"type":"string","title":"Affected Identity (masked)"},"credential_sample":{"type":"string","title":"Credential Sample (masked)","description":"First 2 + last 2 chars, middle masked. Never store the full value."},"credential_hash":{"type":"string","title":"Credential Fingerprint (SHA-256)"},"source_id":{"type":"string","title":"Source ID"},"source_url":{"type":"string","format":"uri","title":"Source URL"},"retrieved_at":{"type":"string","format":"date-time","title":"Retrieved At"},"published_at":{"type":"string","format":"date-time","title":"Published At"},"first_seen":{"type":"string","format":"date-time","title":"First Seen"},"last_seen":{"type":"string","format":"date-time","title":"Last Seen"},"confidence":{"type":"string","enum":["low","medium","high"],"default":"medium","title":"Confidence"},"reliability":{"type":"string","enum":["A","B","C","D","E","F"],"default":"C","title":"Reliability (Admiralty)"},"attribution_status":{"type":"string","enum":["UNCONFIRMED","POSSIBLE","PROBABLE","CONFIRMED"],"default":"UNCONFIRMED","title":"Attribution Status"},"fingerprint":{"type":"string","title":"Evidence Fingerprint"},"terms_class":{"type":"string","enum":["commercial","open","restricted"],"default":"open","title":"Terms/License Class"},"status":{"type":"string","enum":["new","validated","false_positive","remediated"],"default":"new","title":"Status"},"assigned_to":{"type":"string","title":"Assigned To"},"validation_notes":{"type":"string","title":"Validation Notes"},"retention_expires":{"type":"string","format":"date-time","title":"Retention Expires"},"notes":{"type":"string","title":"Notes"}},"required":["organizationId","kind","severity","status"],"rls":{"read":{},"create":{"$or":[{"user_condition":{"role":"admin"}},{"user_condition":{"role":"superadmin"}}]},"update":{"$or":[{"user_condition":{"role":"analyst"}},{"user_condition":{"role":"admin"}},{"user_condition":{"role":"superadmin"}}]},"delete":{"$or":[{"user_condition":{"role":"admin"}},{"user_condition":{"role":"superadmin"}}]}}}