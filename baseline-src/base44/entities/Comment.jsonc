{"name":"Comment","type":"object","properties":{"threat_id":{"type":"string","title":"Threat ID"},"parent_id":{"type":"string","title":"Parent Comment ID","description":"Empty string for top-level comments"},"body":{"type":"string","title":"Body"},"mentions":{"type":"string","title":"Mentions","description":"Comma-separated @mentioned identifiers extracted from body"},"actor_name":{"type":"string","title":"Actor","description":"Display name of the commenter"}},"required":["threat_id","body"],"rls":{"read":{},"create":{},"update":{"$or":[{"user_condition":{"role":"admin"}},{"user_condition":{"role":"superadmin"}}]},"delete":{"$or":[{"user_condition":{"role":"admin"}},{"user_condition":{"role":"superadmin"}}]}}}