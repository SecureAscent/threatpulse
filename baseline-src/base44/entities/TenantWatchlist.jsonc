{"name":"TenantWatchlist","type":"object","properties":{"name":{"type":"string","title":"Name"},"organizationId":{"type":"string","title":"Organization ID","description":"Tenant scope — required for cross-org validation"},"kind":{"type":"string","enum":["domain","keyword","email","identity"],"default":"domain","title":"Kind"},"terms":{"type":"string","title":"Terms","description":"Comma- or newline-separated monitored domains/keywords/emails/identities"},"enabled":{"type":"boolean","default":true,"title":"Enabled"},"owner_name":{"type":"string","title":"Owner"},"notes":{"type":"string","title":"Notes"}},"required":["name","kind"],"rls":{"read":{},"create":{},"update":{"$or":[{"created_by_id":"{{user.id}}"},{"user_condition":{"role":"admin"}},{"user_condition":{"role":"superadmin"}}]},"delete":{"$or":[{"created_by_id":"{{user.id}}"},{"user_condition":{"role":"admin"}},{"user_condition":{"role":"superadmin"}}]}}}