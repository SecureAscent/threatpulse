{"name":"ExposureEvidence","type":"object","properties":{"finding_id":{"type":"string","title":"Finding ID"},"organizationId":{"type":"string","title":"Organization ID","description":"Tenant scope — required for cross-org validation"},"source_id":{"type":"string","title":"Source ID"},"captured_date":{"type":"string","format":"date-time","title":"Captured Date"},"published_date":{"type":"string","format":"date-time","title":"Published Date"},"content_excerpt":{"type":"string","title":"Content Excerpt (masked)","description":"Analyst-approved excerpt; masked until an explicit reveal action"},"fingerprint":{"type":"string","title":"Evidence Fingerprint"},"content_hash":{"type":"string","title":"Content Hash (SHA-256)"},"terms_class":{"type":"string","enum":["commercial","open","restricted"],"default":"open","title":"Terms/License Class"},"revealed":{"type":"boolean","default":false,"title":"Revealed","description":"True only after an explicit reveal action with audit logging"},"reveal_expires":{"type":"string","format":"date-time","title":"Reveal Expires"},"reveal_audit":{"type":"string","title":"Reveal Audit Log","description":"Appends user email + timestamp on each reveal action"},"retention_expires":{"type":"string","format":"date-time","title":"Retention Expires"},"notes":{"type":"string","title":"Notes"}},"required":["finding_id","organizationId"],"rls":{"read":{},"create":{"$or":[{"user_condition":{"role":"admin"}},{"user_condition":{"role":"superadmin"}}]},"update":{"$or":[{"user_condition":{"role":"admin"}},{"user_condition":{"role":"superadmin"}}]},"delete":{"$or":[{"user_condition":{"role":"admin"}},{"user_condition":{"role":"superadmin"}}]}}}