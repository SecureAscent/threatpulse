{"name":"IntelligenceSource","type":"object","properties":{"name":{"type":"string","title":"Name"},"provider":{"type":"string","title":"Provider","description":"e.g. Flare, Flashpoint, SpyCloud, Ransomware.live, CISA, MITRE ATT&CK"},"kind":{"type":"string","enum":["feed","breach_notification","licensed_api","public","tor"],"default":"feed","title":"Kind"},"license_class":{"type":"string","enum":["commercial","open","restricted"],"default":"open","title":"License Class"},"terms_summary":{"type":"string","title":"Terms Summary"},"reliability":{"type":"string","enum":["A","B","C","D","E","F"],"default":"C","title":"Reliability (Admiralty)"},"default_confidence":{"type":"string","enum":["low","medium","high"],"default":"medium","title":"Default Confidence"},"auth_required":{"type":"boolean","default":false,"title":"Auth Required"},"enabled":{"type":"boolean","default":true,"title":"Enabled"},"last_ingested_date":{"type":"string","format":"date-time","title":"Last Ingested"},"ingest_count":{"type":"number","default":0,"title":"Ingest Count"},"last_error":{"type":"string","title":"Last Error"},"notes":{"type":"string","title":"Notes"}},"required":["name","kind","license_class"],"rls":{"read":{},"create":{"$or":[{"user_condition":{"role":"admin"}},{"user_condition":{"role":"superadmin"}}]},"update":{"$or":[{"user_condition":{"role":"admin"}},{"user_condition":{"role":"superadmin"}}]},"delete":{"$or":[{"user_condition":{"role":"admin"}},{"user_condition":{"role":"superadmin"}}]}}}