{
  "description": "When a new Critical-severity threat is created, posts an alert to the configured Slack channel via the Slack Bot connector.",
  "name": "Critical Threat Slack Alert",
  "trigger": {
    "condition": "${ .trigger.data.severity == \"Critical\" }",
    "config": {
      "trigger_type": "entity",
      "entity_name": "Threat",
      "events": [
        "create"
      ]
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "critical_threat_slack_alert",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "post_alert": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendSlackAlert",
            "args": {
              "threat_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Post Slack alert",
            "description": "Notify SOC channel of new Critical threat"
          }
        }
      }
    ]
  }
}