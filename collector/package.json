{
  "name": "threatpulse-collector",
  "version": "1.0.0",
  "private": true,
  "description": "ThreatPulse Intelligence Collector — scheduled worker that ingests CISA KEV, NVD and security RSS feeds into the ThreatPulse database.",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "run-once": "RUN_ONCE=true tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start:prod": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "axios": "1.7.9",
    "node-cron": "3.0.3",
    "pg": "8.13.1",
    "rss-parser": "3.13.0"
  },
  "devDependencies": {
    "@types/node": "20.11.30",
    "@types/node-cron": "3.0.11",
    "@types/pg": "8.11.10",
    "tsx": "4.20.3",
    "typescript": "5.4.5"
  }
}
